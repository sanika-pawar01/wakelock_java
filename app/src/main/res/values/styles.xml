<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base styles for inheritance -->
    <style name="WKCard" parent="Widget.Material3.CardView.Elevated" />
    <style name="WKButton" parent="Widget.Material3.Button" />

    <!-- Calm Component Styles -->
    <style name="WKCard.Calm" parent="WKCard">
        <item name="cardBackgroundColor">@color/surface_calm</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="WKButton.Primary.Calm" parent="WKButton">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Dark Focus Component Styles -->
    <style name="WKCard.Dark" parent="WKCard">
        <item name="cardBackgroundColor">@color/surface_dark</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#33FFFFFF</item>
    </style>
    <style name="WKButton.Primary.Dark" parent="WKButton">
        <item name="backgroundTint">@color/primary_dark</item>
        <item name="android:textColor">#000000</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <!-- Dreamy Component Styles -->
    <style name="WKCard.Dreamy" parent="WKCard">
        <item name="cardBackgroundColor">@color/glass_dreamy</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#40FFFFFF</item>
    </style>
    <style name="WKButton.Primary.Dreamy" parent="WKButton">
        <item name="backgroundTint">@color/primary_dreamy</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Minimal Component Styles -->
    <style name="WKCard.Minimal" parent="WKCard">
        <item name="cardBackgroundColor">@color/surface_minimal</item>
        <item name="cardCornerRadius">4dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/stroke_minimal</item>
    </style>
    <style name="WKButton.Primary.Minimal" parent="WKButton">
        <item name="backgroundTint">@color/primary_minimal</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <!-- Sunrise Component Styles -->
    <style name="WKCard.Sunrise" parent="WKCard">
        <item name="cardBackgroundColor">@color/surface_sunrise</item>
        <item name="cardCornerRadius">40dp</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="WKButton.Primary.Sunrise" parent="WKButton">
        <item name="backgroundTint">@color/primary_sunrise</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Text Appearances -->
    <style name="WKText.Header" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
</resources>