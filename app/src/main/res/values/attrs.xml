<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Background style -->
    <attr name="wkBackgroundStyle" format="enum">
        <enum name="calm" value="0" />
        <enum name="dark" value="1" />
        <enum name="dreamy" value="2" />
        <enum name="minimal" value="3" />
        <enum name="sunrise" value="4" />
    </attr>

    <!-- Surface / Card Style -->
    <attr name="wkCardStyle" format="reference" />
    <attr name="wkCardCornerRadius" format="dimension" />
    <attr name="wkCardElevation" format="dimension" />
    <attr name="wkCardStrokeWidth" format="dimension" />
    <attr name="wkCardStrokeColor" format="color" />
    <attr name="wkCardBackgroundColor" format="color" />

    <!-- Button Styles -->
    <attr name="wkPrimaryButtonStyle" format="reference" />
    <attr name="wkSecondaryButtonStyle" format="reference" />

    <!-- Text Styles -->
    <attr name="wkHeaderTextAppearance" format="reference" />
    <attr name="wkSubHeaderTextAppearance" format="reference" />
    <attr name="wkBodyTextAppearance" format="reference" />

    <!-- Progress / Indicator style -->
    <attr name="wkProgressColor" format="color" />
    <attr name="wkProgressTrackColor" format="color" />

    <!-- Pose Detection Visuals -->
    <attr name="wkSkeletonColor" format="color" />
    <attr name="wkJointColor" format="color" />
    <attr name="wkJointGlowColor" format="color" />
</resources>